rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['admin@eshwarhomeneeds.com', 'admin1@eshwarhomeneeds.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Staff includes admin and explicit staff roles
    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email in ['admin@eshwarhomeneeds.com', 'admin1@eshwarhomeneeds.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isStaff());
      // Users can create/update their own profile. Only admin emails can set the admin role.
      allow create: if isSignedIn() && isOwner(userId) && (
        !request.resource.data.keys().hasAll(['role']) || 
        request.resource.data.role == 'customer' || 
        request.auth.token.email in ['admin@eshwarhomeneeds.com', 'admin1@eshwarhomeneeds.com']
      );
      allow update: if isSignedIn() && isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'creditTerms']) || 
        request.auth.token.email in ['admin@eshwarhomeneeds.com', 'admin1@eshwarhomeneeds.com']
      );
      allow delete: if isAdmin();
    }

    // 2. Products collection
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isStaff();
    }

    // 3. Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 4. Brands collection
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 5. Orders collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Normal customers can only request cancellation, staff can edit status
      allow update: if isSignedIn() && (
        isStaff() || 
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'CANCELLED' && resource.data.status == 'PLACED')
      );
      allow delete: if isAdmin();
    }

    // 6. Quotes collection (Wholesale inquiries)
    match /quotes/{quoteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Customers can accept/reject quotes, admins can update everything
      allow update: if isSignedIn() && (
        isStaff() || 
        (resource.data.userId == request.auth.uid && request.resource.data.status in ['ACCEPTED', 'REJECTED'])
      );
      allow delete: if isAdmin();
    }

    // 7. ScrapRequests collection
    match /scrapRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isStaff() || 
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'CANCELLED' && resource.data.status == 'REQUESTED')
      );
      allow delete: if isAdmin();
    }

    // 8. ScrapRates & ScrapRateHistory
    match /scrapRates/{rateId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /scrapRateHistory/{historyId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // 9. Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; // Anyone can read reviews
      // Customers can write reviews if signed in. Staff/Admins can seed/moderate reviews.
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isStaff());
      // Admins moderate reviews, owners can edit/delete their own before moderation
      allow update, delete: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 10. Offers collection
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 11. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'admin' && isStaff());
      allow write: if isSignedIn(); // Customers can trigger admin alerts, system can write
    }

    // 12. Invoices collection
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow write: if isStaff();
    }
  }
}
